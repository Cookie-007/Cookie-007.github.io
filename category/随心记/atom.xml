    &lt;style&gt;
        /* 图片容器：控制整体布局 */
        .image-container {
            display: flex; /* 开启Flex布局，让子元素（图片）横向排列 */
            justify-content: space-between; /* 图片之间均匀分配空间，两端无多余间隙 */
            gap: 2%; /* 图片之间的固定间距（避免过挤），可根据需求调整 */
            width: 100%; /* 容器占满父级宽度，确保图片整体居中 */
            max-width: 1200px; /* 可选：限制容器最大宽度，避免大屏幕下图片过宽 */
            margin: 0 auto; /* 可选：让容器本身水平居中 */
            padding: 10px 0; /* 可选：上下留少量内边距，增加呼吸感 */
        }
        .image-container img {
            flex: 1; /* 关键：让每张图片宽度自动均分容器剩余空间，确保完全均匀 */
            height: auto; /* 保持图片原有宽高比，避免拉伸变形 */
            border-radius: 8px; /* 圆角大小，数值越大圆角越明显（如12px更圆润） */
            border: none; /* 清除图片默认边框（若有） */
            object-fit: cover; /* 可选：若图片尺寸不一致，按比例裁剪填满容器（避免变形） */
            box-shadow: 0 8px 15px 5px rgba(0, 0, 0, 0.35);
        }
        @media (max-width: 768px) {
            .image-container {
                flex-direction: column; /* 小屏幕下纵向排列 */
                gap: 1rem; /* 纵向间距，比横向稍大更协调 */
            }
            .image-container img {
                width: 100%; /* 小屏幕下图片占满宽度 */
                max-height: 300px; /* 可选：限制图片最大高度，避免过长 */
